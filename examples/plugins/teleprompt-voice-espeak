#!/usr/bin/env python3
"""teleprompt-voice-espeak: narration spoken by eSpeak NG, as a voice plugin.

eSpeak NG is a small, offline speech synthesizer: robotic, but free,
local and in over a hundred languages. In teleprompt.toml:

    [voice]
    backend = "espeak"
    voice = "en-us"        # optional: `espeak-ng --voices` lists them

    [backends.espeak]
    wpm = 160              # optional: words per minute at speed 1.0

Put it on PATH, or in teleprompt's plugins directory, and `teleprompt
plugins` lists it. The protocol is in docs/guide/voices.md#as-a-program.
Python's standard library alone.
"""

import base64
import json
import shutil
import subprocess
import sys
from collections.abc import Callable
from dataclasses import dataclass
from typing import Any

Json = dict[str, Any]

ESPEAK_NG: Json = {
    "name": "espeak-ng",
    "what": 'speaks the narration, when `voice.backend` is "espeak"',
    "license": "GPL-3.0-or-later",
    "home": "https://github.com/espeak-ng/espeak-ng",
    "program": "espeak-ng",
    "install": {
        "brew": "brew install espeak-ng",
        "apt": "sudo apt-get install -y espeak-ng",
        "dnf": "sudo dnf install -y espeak-ng",
        "pacman": "sudo pacman -S --needed --noconfirm espeak-ng",
    },
}


def espeak(*args: str) -> bytes:
    """Runs eSpeak NG and returns what it printed."""
    program = shutil.which("espeak-ng") or shutil.which("espeak")
    if program is None:
        raise RuntimeError("espeak-ng is not on PATH: `teleprompt setup espeak` says how to install it")
    return subprocess.run([program, *args], check=True, capture_output=True).stdout


@dataclass
class Settings:
    """`[backends.espeak]`, which comes with every request."""

    wpm: int = 160

    @classmethod
    def parse(cls, given: Json | None) -> "Settings":
        given = given or {}
        if unknown := set(given) - {"wpm"}:
            raise ValueError(f"[backends.espeak] has no setting {', '.join(sorted(unknown))}")
        wpm = given.get("wpm", cls.wpm)
        if not isinstance(wpm, int) or not 80 <= wpm <= 450:
            raise ValueError("[backends.espeak] wpm is a whole number from 80 to 450")
        return cls(wpm=wpm)


def describe(params: Json) -> Json:
    # What the audio depends on beyond the request and the settings: the
    # program's version, but not where its data is, as a cache key naming a
    # machine is a cache that never leaves it.
    version = espeak("--version").decode().split("Data at")[0].strip()
    return {
        "protocol": 1,
        "kind": "voice",
        "name": "espeak",
        "needs": [ESPEAK_NG],
        "version": version,
        "speed_control": True,
    }


def synthesize(params: Json) -> Json:
    settings = Settings.parse(params.get("settings"))
    voice = params.get("voice") or params["locale"].lower()
    rate = round(settings.wpm * params.get("speed", 1.0))
    wav = espeak("-v", voice, "-s", str(rate), "--stdout", params["text"])
    return {"audio": base64.b64encode(wav).decode()}


def voices(params: Json) -> Json:
    # Pty Language Age/Gender VoiceName File Other: the language column.
    rows = espeak("--voices").decode().splitlines()[1:]
    return {"voices": sorted({row.split()[1] for row in rows if row.split()})}


def serve(methods: dict[str, Callable[[Json], Json]]) -> None:
    """Answers teleprompt's requests, one JSON object a line, until it is done."""
    for line in sys.stdin:
        if not line.strip():
            continue
        request = json.loads(line)
        method = methods.get(request.get("method"))
        try:
            if method is None:
                raise LookupError(f"unknown method `{request.get('method')}`")
            reply = {"id": request.get("id"), "result": method(request.get("params") or {})}
        except Exception as e:  # the answer says why, and teleprompt reports it
            reply = {"id": request.get("id"), "error": str(e)}
        print(json.dumps(reply), flush=True)


if __name__ == "__main__":
    serve({"describe": describe, "synthesize": synthesize, "voices": voices})
