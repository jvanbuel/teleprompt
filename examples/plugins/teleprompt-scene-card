#!/usr/bin/env python3
"""teleprompt-scene-card: a scene of plain colour cards, as a scene plugin.

A block of `scene=card` holds lines like these, split into shots at `mark`:

    color #1d4ed8
    hold 2s
    mark
    color black

It is the smallest complete scene plugin: it checks a block, splits it into
shots and says how long each takes (offline, for `check` and `plan`), and
captures each shot with ffmpeg. Put it on PATH, or in teleprompt's plugins
directory, and `teleprompt plugins` lists it. The protocol is in
docs/guide/scene-plugins.md#the-protocol. Python's standard library alone.
"""

import json
import re
import subprocess
import sys
from collections.abc import Callable, Iterator
from typing import Any, NamedTuple

Json = dict[str, Any]
Progress = Callable[[Json], None]

DURATION = re.compile(r"^(\d+(?:\.\d+)?)(ms|s)$")
COLOR = re.compile(r"^(#[0-9a-fA-F]{6}|[a-zA-Z]+)$")
HELP = "a card understands `color <name or #rrggbb>`, `hold <duration>` and `mark`"

FFMPEG: Json = {
    "name": "ffmpeg",
    "what": "renders the video, and captures media, slide and terminal scenes",
    "license": "LGPL-2.1-or-later, or GPL-2.0-or-later as many builds are",
    "home": "https://ffmpeg.org",
    "program": "ffmpeg",
    "install": {"brew": "brew install ffmpeg", "apt": "sudo apt-get install -y ffmpeg"},
}


class Directive(NamedTuple):
    line: int  # from 0, in the block's body
    name: str
    argument: str


def directives(body: str) -> Iterator[Directive]:
    """Each line that says something, skipping blanks and `#` comments."""
    for line, text in enumerate(body.splitlines()):
        text = text.strip()
        if text and not text.startswith("#"):
            name, _, argument = text.partition(" ")
            yield Directive(line, name, argument.strip())


def milliseconds(text: str) -> int | None:
    """`2s` or `500ms` as milliseconds; None for anything else."""
    if m := DURATION.match(text):
        value = float(m.group(1))
        return round(value * 1000 if m.group(2) == "s" else value)
    return None


def problem(d: Directive) -> str | None:
    """What is wrong with a directive, if anything."""
    if d.name == "mark" and d.argument:
        return "`mark` takes no arguments"
    if d.name == "color" and not COLOR.match(d.argument):
        return f"`color` needs a name or #rrggbb, not `{d.argument}`"
    if d.name == "hold" and milliseconds(d.argument) is None:
        return f"`hold` needs a duration, such as 2s, not `{d.argument}`"
    if d.name not in ("mark", "color", "hold"):
        return f"unknown card directive `{d.name}`"
    return None


def timing(source: str) -> Json:
    """A shot and how long it lasts: its holds, or its line's length if none."""
    holds = [milliseconds(d.argument) or 0 for d in directives(source) if d.name == "hold"]
    return {"source": source, "ms": sum(holds), "exact": True} if holds else {"source": source}


class Card:
    """The scene plugin, a method for each of teleprompt's requests."""

    def describe(self, params: Json, progress: Progress) -> Json:
        # A card's picture is its source alone. Without ffmpeg on PATH,
        # teleprompt knows from `needs` that it cannot capture.
        return {"protocol": 1, "name": "card", "needs": [FFMPEG], "continues": False}

    def validate(self, params: Json, progress: Progress) -> Json:
        errors = []
        for d in directives(params["body"]):
            if message := problem(d):
                error = {"line": d.line, "message": message}
                if d.name not in ("mark", "color", "hold"):
                    error["help"] = HELP
                errors.append(error)
        return {"errors": errors}

    def shots(self, params: Json, progress: Progress) -> Json:
        sources = re.split(r"^\s*mark\s*$", params["body"], flags=re.MULTILINE)
        return {"shots": [timing(s.strip()) for s in sources if any(directives(s))]}

    def retime(self, params: Json, progress: Progress) -> Json:
        kept = [line for line in params["source"].splitlines() if not line.strip().startswith("hold")]
        return {"source": "\n".join([*kept, f"hold {params['target_ms']}ms"])}

    def capture(self, params: Json, progress: Progress) -> Json:
        frame, out = params["frame"], params["out_dir"]
        wanted = [shot for shot in params["session"]["shots"] if shot["wanted"]]
        clips = []
        for shot in wanted:
            colors = [d.argument for d in directives(shot["source"]) if d.name == "color"]
            picture = f"color=c={colors[-1] if colors else 'black'}"
            picture += f":s={frame['width']}x{frame['height']}:r={frame['fps']}"
            path = f"{out}/{shot['key']}.mp4"
            seconds = f"{shot['duration_ms'] / 1000:.3f}"
            subprocess.run(
                ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-f", "lavfi", "-t", seconds]
                + ["-i", picture, "-pix_fmt", "yuv420p", path],
                check=True,
                stdin=subprocess.DEVNULL,
            )
            clips.append({"key": shot["key"], "path": path})
            progress({"shot": shot["id"], "done": len(clips), "of": len(wanted)})
        return {"clips": clips}


def reporter(rid: object) -> Progress:
    """Tells teleprompt how request `rid` is going, before its answer."""

    def progress(event: Json) -> None:
        print(json.dumps({"id": rid, "progress": event}), flush=True)

    return progress


def serve(methods: dict[str, Callable[[Json, Progress], Json]]) -> None:
    """Answers teleprompt's requests, one JSON object a line, until it is done."""
    for line in sys.stdin:
        if not line.strip():
            continue
        request = json.loads(line)
        rid = request.get("id")
        progress = reporter(rid)
        method = methods.get(request.get("method"))
        try:
            if method is None:
                raise LookupError(f"unknown method `{request.get('method')}`")
            reply = {"id": rid, "result": method(request.get("params") or {}, progress)}
        except Exception as e:  # noqa: BLE001 -- the answer says why, and teleprompt reports it
            reply = {"id": rid, "error": str(e)}
        print(json.dumps(reply), flush=True)


if __name__ == "__main__":
    card = Card()
    serve({name: getattr(card, name) for name in dir(card) if not name.startswith("_")})
