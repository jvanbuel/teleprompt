      "source_hash": "4b380a79f5acfff997d3b61abf110c87862f8d41315cba07e67647d7ccb903a7",
      "start_ms": 12450,
      "text": "Everything you see here is generated from a single Markdown file that lives in version control alongside the code it documents."
    },
    {
      "audio": "audio/deploy.wav",
      "audio_hash": "df3c78b1e4c583118fd965a1dd1554d9c450e27e4e4f831218f076b01c0cce66",
