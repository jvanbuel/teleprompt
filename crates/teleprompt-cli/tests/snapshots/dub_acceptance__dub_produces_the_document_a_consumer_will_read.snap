      "start_ms": 21950,
      "text": "Deployment is one command, and it streams progress as it goes."
    },
    {
      "audio": "audio/rollback.wav",
      "audio_hash": "5792270852a847043c21ed9f704aec5f3fcad6df026897cd5864cb201bfca5da",
